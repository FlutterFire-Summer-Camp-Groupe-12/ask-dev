rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Un non-connecté ne doit pas écrire ; request.auth est null dans ce cas.
    function signedIn() {
      return request.auth != null;
    }

    function isAuthor(field) {
      return signedIn() && request.auth.uid == request.resource.data[field];
    }

    function isExistingAuthor(field) {
      return signedIn() && request.auth.uid == resource.data[field];
    }

    // Seule la clé answersCount change (incrément/décrément par une réponse).
    function onlyAnswersCountChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answersCount']);
    }

    match /users/{userId} {
      allow read: if true; // profils publics pour afficher les auteurs
      allow create: if isAuthor('uid');
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /questions/{questionId} {
      allow read: if true; // forum public
      allow create: if isAuthor('authorId');
      // L'auteur édite sa question ; n'importe qui peut incrémenter
      // answersCount quand il pose/supprime une réponse.
      allow update: if signedIn() && (
        isExistingAuthor('authorId') || onlyAnswersCountChanged()
      );
      allow delete: if isExistingAuthor('authorId');

      match /answers/{answerId} {
        allow read: if true;
        allow create: if isAuthor('authorId');
        allow update: if isExistingAuthor('authorId');
        // Suppression par l'auteur de la réponse, ou par l'auteur de la
        // question lors de la suppression complète de celle-ci.
        allow delete: if isExistingAuthor('authorId')
          || (signedIn() && get(/databases/$(database)/documents/questions/$(questionId)).data.authorId == request.auth.uid);
      }
    }

    // Requêtes de groupe collectionGroup('answers') : compteur et réponses
    // d'un utilisateur à travers toutes les questions. Lecture publique
    // comme le reste du forum.
    match /{path=**}/answers/{answerId} {
      allow read: if true;
    }
  }
}